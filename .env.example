# Copie este arquivo para .env e preencha
# --- Servimed (fornecedor) ---
SERVIMED_USER=
SERVIMED_PASSWORD=

# API JSON consumida pelo site (login e listagem de produtos)
SERVIMED_API_BASE_URL=https://peapi.servimed.com.br
# Enviados como Origin e Referer nas requisições
SERVIMED_SITE_ORIGIN=https://pedidoeletronico.servimed.com.br
# Parâmetro siteVersion da busca de produtos (versão do front-end do site)
SERVIMED_SITE_VERSION=4.0.29

# Campo do JSON da Servimed usado como preco_fabrica (ver README)
SERVIMED_PRICE_FIELD=valorBase

# --- Scrapy ---
SCRAPY_DOWNLOAD_DELAY=0.25
SCRAPY_CONCURRENT_REQUESTS=4
SCRAPY_LOG_LEVEL=INFO

# --- API do desafio (callback) ---
# Confirmar o host no campo "Servers" do Swagger (https://desafio.cotefacil.net/docs)
DESAFIO_API_BASE_URL=https://desafio.cotefacil.net
# Usuário criado em /oauth/signup (username 3-50 caracteres, password 8-64)
DESAFIO_API_USER=
DESAFIO_API_PASSWORD=
DESAFIO_API_TIMEOUT=10
# Tamanho do lote enviado em POST /produto (ajustar conforme o limite da API)
DESAFIO_API_BATCH_SIZE=500

# --- Fila (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0
# Tempo máximo de uma tarefa de scraping, em segundos
TASK_TIME_LIMIT=1800

# --- Geral ---
LOG_LEVEL=INFO
# Pasta dos arquivos JSON temporários por tarefa
TMP_DIR=tmp
